{
  "sourceLanguage": "en",
  "strings": {
    "%@ is turned off in Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in den Einstellungen ausgeschaltet"
          }
        }
      }
    },
    "-optimized": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "-optimiert"
          }
        }
      }
    },
    "a JPEG XL viewer would show it differently": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein JPEG-XL-Programm würde es anders zeigen"
          }
        }
      }
    },
    "Animated WebP is not supported yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiertes WebP wird noch nicht unterstützt"
          }
        }
      }
    },
    "Apple’s iPhone PNG variant (CgBI), which only Apple’s tools can read": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples iPhone-Variante von PNG (CgBI), die nur Apples Werkzeuge lesen können"
          }
        }
      }
    },
    "Checking": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen"
          }
        }
      }
    },
    "copyright or creator information lost": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Urheber- oder Copyright-Angaben gingen verloren"
          }
        }
      }
    },
    "copyright or creator information would be hidden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Urheber- oder Rechteangaben wären nicht mehr sichtbar"
          }
        }
      }
    },
    "Empty file": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Datei"
          }
        }
      }
    },
    "GIF optimization comes in a later version": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-Optimierung kommt in einer späteren Version"
          }
        }
      }
    },
    "Has Content Credentials (C2PA). Converting would invalidate them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat Content Credentials (C2PA). Umwandeln würde sie ungültig machen."
          }
        }
      }
    },
    "HDR HEIC images are left untouched": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR-HEIC-Bilder bleiben unverändert"
          }
        }
      }
    },
    "HEIC can only be optimized in lossy mode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC lässt sich nur verlustbehaftet optimieren"
          }
        }
      }
    },
    "Has Content Credentials (C2PA). Optimizing would invalidate them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält einen Herkunftsnachweis (C2PA). Eine Optimierung würde ihn ungültig machen."
          }
        }
      }
    },
    "Holds data after the image that a JPEG XL viewer wouldn’t know": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Daten nach dem Bild, die ein JPEG-XL-Programm nicht kennen würde"
          }
        }
      }
    },
    "Holds more than one image (HDR gain map, depth map or a second view) – a JPEG XL viewer would show only the photo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält mehr als ein Bild (HDR-Gain-Map, Tiefenkarte oder zweite Ansicht) – ein JPEG-XL-Programm würde nur das Foto zeigen"
          }
        }
      }
    },
    "invalid file structure (JPEG)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ungültiger Dateiaufbau (JPEG)"
          }
        }
      }
    },
    "it would be shown in other colours": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "es würde in anderen Farben angezeigt"
          }
        }
      }
    },
    "Lossy WebP can’t be optimized without loss": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustbehaftetes WebP lässt sich nicht verlustfrei optimieren"
          }
        }
      }
    },
    "Metadata": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten"
          }
        }
      }
    },
    "metadata changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten verändert"
          }
        }
      }
    },
    "metadata that should have been removed is still there": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten, die entfernt werden sollten, sind noch da"
          }
        }
      }
    },
    "Motion photo – a JPEG XL viewer would show only the photo, not the video": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion Photo – ein JPEG-XL-Programm würde nur das Foto zeigen, nicht das Video"
          }
        }
      }
    },
    "Not a supported image": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein unterstütztes Bildformat"
          }
        }
      }
    },
    "Not converted – result rejected: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht umgewandelt – Ergebnis verworfen: %@"
          }
        }
      }
    },
    "Nothing to optimize": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu optimieren"
          }
        }
      }
    },
    "Only JPEG XL files can be converted back to JPEG": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur JPEG-XL-Dateien lassen sich zurück in JPEG umwandeln"
          }
        }
      }
    },
    "Only JPEGs can be converted to JPEG XL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur JPEGs lassen sich in JPEG XL umwandeln"
          }
        }
      }
    },
    "Result rejected: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnis verworfen: %@"
          }
        }
      }
    },
    "The file changed while it was being converted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat sich während des Umwandelns geändert"
          }
        }
      }
    },
    "The file changed while it was being optimized": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde während der Optimierung verändert"
          }
        }
      }
    },
    "The file is damaged or incomplete": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist beschädigt oder unvollständig"
          }
        }
      }
    },
    "The file or its folder is read-only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei oder ihr Ordner ist schreibgeschützt"
          }
        }
      }
    },
    "The folder for the new file is read-only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner für die neue Datei ist schreibgeschützt"
          }
        }
      }
    },
    "the JPEG can’t be rebuilt from it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "das JPEG lässt sich daraus nicht zurückgewinnen"
          }
        }
      }
    },
    "The metadata couldn’t be filtered safely: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Metadaten ließen sich nicht sicher filtern: %@"
          }
        }
      }
    },
    "The optimizer is missing from the app bundle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Optimierungswerkzeug fehlt im App-Bundle."
          }
        }
      }
    },
    "animation timing changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animationszeiten verändert"
          }
        }
      }
    },
    "color profile lost": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbprofil verloren"
          }
        }
      }
    },
    "different dimensions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "andere Abmessungen"
          }
        }
      }
    },
    "looks different": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sieht anders aus"
          }
        }
      }
    },
    "orientation lost": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausrichtung verloren"
          }
        }
      }
    },
    "original": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Original"
          }
        }
      }
    },
    "invalid file structure (%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ungültiger Dateiaufbau (%@)"
          }
        }
      }
    },
    "pixels changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixel verändert"
          }
        }
      }
    },
    "SVG could not be rendered": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG ließ sich nicht darstellen"
          }
        }
      }
    },
    "the rebuilt JPEG differs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "das zurückgewonnene JPEG weicht ab"
          }
        }
      }
    },
    "This JPEG can’t be stored as JPEG XL without loss (CMYK, arithmetic coding, 12 bits, or too much data after the image)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses JPEG lässt sich nicht verlustfrei als JPEG XL speichern (CMYK, arithmetische Kodierung, 12 Bit oder zu viele Daten nach dem Bild)"
          }
        }
      }
    },
    "This JPEG XL wasn’t made from a JPEG, so there is no JPEG to go back to": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses JPEG XL ist nicht aus einem JPEG entstanden – es gibt kein JPEG, zu dem es zurück könnte"
          }
        }
      }
    },
    "Unchanged – result rejected: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverändert – Ergebnis verworfen: %@"
          }
        }
      }
    },
    "Contains scripts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Skripte"
          }
        }
      }
    },
    "Contains animation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Animationen"
          }
        }
      }
    },
    "Contains embedded HTML": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält eingebettetes HTML"
          }
        }
      }
    },
    "Contains CSS that can’t be checked": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält CSS, das sich nicht prüfen lässt"
          }
        }
      }
    },
    "%@ – left unchanged, it can’t be checked safely": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – unverändert gelassen, lässt sich nicht sicher prüfen"
          }
        }
      }
    },
    "contains content that can’t be checked": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "enthält Inhalte, die sich nicht prüfen lassen"
          }
        }
      }
    },
    "The optimized file couldn’t be put in place. The original is in the Trash as “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die optimierte Datei ließ sich nicht an ihren Platz legen. Das Original liegt im Papierkorb als „%@“."
          }
        }
      }
    },
    "Holds images that can’t be read safely – left unchanged": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Bilder, die sich nicht sicher lesen lassen – unverändert gelassen"
          }
        }
      }
    },
    "Motion photo whose video can’t be located safely – left unchanged": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegtfoto, dessen Video sich nicht sicher finden lässt – unverändert gelassen"
          }
        }
      }
    },
    "HDR brightness changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR-Helligkeit verändert"
          }
        }
      }
    },
    "a part that must stay as it is (a video, the camera maker’s data) holds metadata this level removes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein Teil, der unverändert bleiben muss (ein Video, Daten des Kameraherstellers), enthält Metadaten, die diese Stufe entfernt"
          }
        }
      }
    },
    "an image that must stay as it is (depth map, gain map) holds metadata this level removes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein Bild, das unverändert bleiben muss (Tiefenkarte, Gain Map), enthält Metadaten, die diese Stufe entfernt"
          }
        }
      }
    },
    "animation or second image lost": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation oder zweites Bild verloren"
          }
        }
      }
    },
    "The output would take the original’s place. Choose another output folder or suffix.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis würde das Original ersetzen. Wähle einen anderen Ausgabeordner oder ein anderes Suffix."
          }
        }
      }
    },
    "The optimizer took too long and was stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Optimierungswerkzeug brauchte zu lange und wurde gestoppt."
          }
        }
      }
    },
    "Couldn’t be read completely": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ließ sich nicht vollständig lesen"
          }
        }
      }
    },
    "Unchanged – the metadata couldn’t be filtered safely: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverändert – die Metadaten ließen sich nicht sicher filtern: %@"
          }
        }
      }
    },
    "text changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text verändert"
          }
        }
      }
    },
    "the decoder reports damaged data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "der Decoder meldet beschädigte Daten"
          }
        }
      }
    },
    "unreadable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nicht lesbar"
          }
        }
      }
    },
    "The optimized file is in place, but the original couldn’t be kept next to it. Move it somewhere safe from “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die optimierte Datei ist an ihrem Platz, aber das Original ließ sich nicht daneben ablegen. Bring es von „%@“ in Sicherheit."
          }
        }
      }
    },
    "The optimized file couldn’t be put in place. Move the original somewhere safe from “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die optimierte Datei ließ sich nicht an ihren Platz legen. Bring das Original von „%@“ in Sicherheit."
          }
        }
      }
    }
  },
  "version": "1.0"
}