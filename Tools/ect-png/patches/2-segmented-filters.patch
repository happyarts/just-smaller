+  for(unsigned y = y0; y < y1; ++y) {
+    out[0] = types[y];
+    filterScanline(out + 1, &in[(size_t)y * linebytes], y ? &in[(size_t)(y - 1) * linebytes] : 0,
+                   linebytes, bytewidth, types[y]);
+    out += linebytes + 1;
+  }
+}
