+/* log2(x) in 1/256 bits, for x >= 1, with integer arithmetic only. */
+static u32
+deflate_log2_q8(u32 x)
+{
+	unsigned int_part = bsr32(x);
+	u64 y = (u64)x << (31 - int_part); /* in [2^31, 2^32) */
+	u32 frac = 0;
+	int i;
+
+	for (i = 0; i < 8; i++) {
+		y = (y * y) >> 31;
+		frac <<= 1;
+		if (y >= ((u64)1 << 32)) {
+			frac |= 1;
+			y >>= 1;
+		}
+	}
+	return (int_part << 8) | frac;
+}
