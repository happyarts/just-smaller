+    struct Shared {
+        /// The next chunk to work on, and the next to write.
+        next: usize,
+        written: usize,
+        plans: Vec<Option<BlockPlan>>,
+        /// A worker panicked.
+        failed: bool,
+    }
+
+    /// When its thread panics, stops the others from waiting: no more chunks
+    /// are handed out, and the writing thread doesn't wait for one that never
+    /// comes.
+    struct PanicGuard<'a>(&'a Mutex<Shared>, &'a Condvar, usize);
+    impl Drop for PanicGuard<'_> {
+        fn drop(&mut self) {
+            if std::thread::panicking() {
+                let mut s = self.0.lock().unwrap_or_else(|e| e.into_inner());
+                s.failed = true;
+                s.next = self.2;
+                drop(s);
+                self.1.notify_all();
+            }
+        }
+    }
