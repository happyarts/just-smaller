+    /// A sink that fails once `room` bytes are written.
+    struct Failing {
+        room: usize,
+    }
+
+    impl io::Write for Failing {
+        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+            if buf.len() > self.room {
+                return Err(io::Error::new(io::ErrorKind::Other, "full"));
+            }
+            self.room -= buf.len();
+            Ok(buf.len())
+        }
