+                &ll_counts[..],
+                &d_counts[..],
+                ll,
+                d,
+                lz77,
+                lstart,
+                lend,
+            )
+    };
+    let mut best = (size(&ll_lengths, &d_lengths), ll_lengths, d_lengths);
