+    let shared = Mutex::new(Shared {
+        next: 0,
+        written: 0,
+        plans: ends.iter().map(|_| None).collect(),
+        failed: false,
+    });
+    let changed = Condvar::new();
+    let work = || {
+        let _guard = PanicGuard(&shared, &changed, ends.len());
+        loop {
+            let k = {
+                let mut s = shared.lock().unwrap();
+                while s.next < ends.len() && s.next >= s.written + ahead {
+                    s = changed.wait(s).unwrap();
+                }
+                if s.next >= ends.len() {
